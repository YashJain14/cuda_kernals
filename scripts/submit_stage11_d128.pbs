#!/bin/bash
#PBS -N stage11_d128_flashattn
#PBS -l select=1:ngpus=1
#PBS -l walltime=00:15:00
#PBS -q normal
#PBS -j oe
#PBS -o stage11_d128_output.log
#PBS -P 52001004

# ============================================================
#  SC4064 FlashAttention — Stage 11 d=128 Benchmark Job
# ============================================================

set -e
cd "$PBS_O_WORKDIR"

# ── Modules ───────────────────────────────────────────────────────────────────
module purge
module load cuda/12.2.2

# ── Environment ──
echo "--- Environment ---"
nvcc --version | head -1
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader
echo ""

# ── Build ─────────────────────────────────────────────────────────────────────
CUTLASS_PATH="$HOME/cuda_kernals/cutlass"

echo "--- Building Stage 11 (d=128) ---"
nvcc -O3 -arch=sm_80 --use_fast_math -std=c++17 \
     --expt-relaxed-constexpr \
     -I"$CUTLASS_PATH/include" \
     src/stage11_d128.cu -o stage11_d128_test -lcublas

echo "Build OK"
echo ""

# ── Run Benchmark ─────────────────────────────────────────────────────────────
echo "--- Running Stage 11 (d=128) Benchmark ---"
./stage11_d128_test

echo ""
echo "Job finished: $(date)"
