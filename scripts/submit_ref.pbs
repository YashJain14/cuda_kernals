#!/bin/bash
#PBS -N flash_reference
#PBS -l select=1:ngpus=1
#PBS -l walltime=00:10:00
#PBS -q normal
#PBS -j oe
#PBS -o ref_output.log
#PBS -P 52001004

# ============================================================
#  SC4064 FlashAttention — Official FlashAttention-2 Reference
#  Uses cluster pytorch/2.6.0-py3-cu11.8 module (has SDPA/FA-2)
#  then tries to install flash-attn via conda if available.
#  Config: B=2, nh=16, d=64, N in {1024,2048,4096}, fp16
# ============================================================

set -e
cd "$PBS_O_WORKDIR"

# ── 1. Load basic CUDA drivers only ──────────────────────────
# We load this just to ensure the system paths see the A100 drivers, 
# but we rely on your Conda env for the actual logic.
module purge
module load cuda/12.2.1

# ── 2. Activate your Specific Environment ─────────────────────
CONDA_DIR="$HOME/miniconda3"
source "$CONDA_DIR/etc/profile.d/conda.sh"
conda activate flashenv

# ── 3. Verification ──────────────────────────────────────────
echo "--- Runtime Environment ---"
python -c "import torch; import flash_attn; print(f'Torch: {torch.__version__} | Flash-Attn: {flash_attn.__version__}')"
nvidia-smi --query-gpu=name,compute_cap --format=csv,noheader

# ── 4. Run the Benchmark ─────────────────────────────────────
echo ""
echo "--- Starting Reference Benchmark ---"
# We call 'python' directly to ensure it uses the one in flashenv
python reference/reference.py
python reference/reference_d128.py

echo ""
echo "Benchmark Completed: $(date)"