#!/bin/bash
#PBS -N sc4064_flashattn
#PBS -l select=1:ngpus=1
#PBS -l walltime=00:45:00
#PBS -q normal
#PBS -j oe
#PBS -o flash_run.log
#PBS -P 52001004

# ============================================================
#  SC4064 FlashAttention — Full Benchmark Job
#
#  Produces:
#    flash_run.log      — this file
#    bench_cuda.log     — Stages 0-4
#    bench_cublas.log   — cuBLAS TC ceiling
#    bench_pytorch.log  — PyTorch FlashAttention-2
#    profile_v3.log     — Nsight: Stage 3 (wmma 32x32)
#    profile_v4.log     — Nsight: Stage 4 (wmma 64x64)
#    summary.log        — comparison table
# ============================================================

set -e
cd "$PBS_O_WORKDIR"

echo "============================================================"
echo "  Job:         $PBS_JOBID"
echo "  Node:        $(hostname)"
echo "  Started:     $(date)"
echo "  Working dir: $PBS_O_WORKDIR"
echo "============================================================"
echo ""

# ── Modules ───────────────────────────────────────────────────────────────────
module purge
module load cuda/12.2.2

echo "--- Environment ---"
nvcc --version | head -1
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader
echo ""

# ── Conda ─────────────────────────────────────────────────────────────────────
CONDA_DIR="$HOME/miniconda3"
source "$CONDA_DIR/etc/profile.d/conda.sh"
conda activate sc4064
echo "Python:  $(python3 --version)"
echo "PyTorch: $(python3 -c 'import torch; print(torch.__version__)' 2>/dev/null || echo 'not found')"
echo ""

# ── Build ─────────────────────────────────────────────────────────────────────
echo "--- Build ---"
make clean
make all
echo "Build OK"
echo ""

# ── CUDA benchmark ────────────────────────────────────────────────────────────
echo "--- CUDA benchmark: Stages 0-4 ---"
./flash_attn 2>&1 | tee bench_cuda.log
echo ""

# ── cuBLAS ceiling ────────────────────────────────────────────────────────────
echo "--- cuBLAS Tensor Core ceiling ---"
./cublas_ref 2>&1 | tee bench_cublas.log
echo ""

# ── PyTorch reference ─────────────────────────────────────────────────────────
echo "--- PyTorch SDPA reference ---"
python3 reference.py 2>&1 | tee bench_pytorch.log
echo ""

# ── Nsight profiling ──────────────────────────────────────────────────────────
# FIX: single quoted comma-separated string — NOT repeated --metrics flags.
# launch-skip 26: skips warmup(3) + iters(10) for N=1024, then warmup(3) + iters(10)
# for N=2048 = 26 kernel launches before we hit the first N=4096 invocation.
METRICS="gpu__time_duration.avg,sm__throughput.avg_pct_of_peak_sustained_elapsed,dram__bytes_read.sum,dram__bytes_write.sum,dram__throughput.avg_pct_of_peak_sustained_elapsed,sm__warps_active.avg_pct_of_peak_sustained_active,smsp__warp_issue_stalled_long_scoreboard_per_warp_active.pct,smsp__warp_issue_stalled_short_scoreboard_per_warp_active.pct,smsp__warp_issue_stalled_wait_per_warp_active.pct"

echo "--- Nsight: Stage 3 (flash_wmma_v3) at N=4096 ---"
if command -v ncu &>/dev/null; then
    ncu --kernel-name flash_wmma_v3 \
        --launch-skip 26 --launch-count 1 \
        --metrics "$METRICS" \
        ./flash_attn 2>&1 | tee profile_v3.log
else
    echo "ncu not in PATH — skipping" | tee profile_v3.log
fi
echo ""

echo "--- Nsight: Stage 4 (flash_wmma_v4) at N=4096 ---"
if command -v ncu &>/dev/null; then
    ncu --kernel-name flash_wmma_v4 \
        --launch-skip 26 --launch-count 1 \
        --metrics "$METRICS" \
        ./flash_attn 2>&1 | tee profile_v4.log
else
    echo "ncu not in PATH — skipping" | tee profile_v4.log
fi
echo ""

# ── Summary ───────────────────────────────────────────────────────────────────
echo "--- Generating summary ---"
{
echo "============================================================"
echo "  SC4064 FlashAttention — Results Summary"
echo "  $(date)"
echo "  GPU: $(nvidia-smi --query-gpu=name --format=csv,noheader | head -1)"
echo "============================================================"
echo ""

echo "=== CUDA Kernel Stages (N=4096) ==="
awk '/N = 4096/{p=1} p && /Stage/{print "  "$0} p && /^$/{p=0}' bench_cuda.log
echo ""

echo "=== cuBLAS Tensor Core Ceiling ==="
grep -E "N =|ceiling" bench_cublas.log | sed 's/^/  /'
echo ""

echo "=== PyTorch FlashAttention-2 Reference (fp16) ==="
awk '/dtype = fp16/{p=1} p && /N=/{print "  "$0} p && /^$/{p=0}' bench_pytorch.log | head -3
echo ""

echo "=== Speedup Table (N=4096) ==="
S0=$(awk '/N = 4096/{p=1} p && /Stage 0/{print $5; exit}' bench_cuda.log)
S3=$(awk '/N = 4096/{p=1} p && /Stage 3/{print $5; exit}' bench_cuda.log)
S4=$(awk '/N = 4096/{p=1} p && /Stage 4/{print $5; exit}' bench_cuda.log)
T3=$(awk '/N = 4096/{p=1} p && /Stage 3/{print $7; exit}' bench_cuda.log)
T4=$(awk '/N = 4096/{p=1} p && /Stage 4/{print $7; exit}' bench_cuda.log)
PT=$(awk '/dtype = fp16/{p=1} p && /N= *4096/{print $2; exit}' bench_pytorch.log)
PT_T=$(awk '/dtype = fp16/{p=1} p && /N= *4096/{print $4; exit}' bench_pytorch.log)
CB=$(awk '/N = 4096/{p=1} p && /ceiling/{print $7; exit}' bench_cublas.log)

printf "  %-28s %8s ms   %s TFLOPS\n" "Stage 0 (Naive):"      "$S0" "—"
printf "  %-28s %8s ms   %s TFLOPS\n" "Stage 3 (wmma 32x32):" "$S3" "$T3"
printf "  %-28s %8s ms   %s TFLOPS\n" "Stage 4 (wmma 64x64):" "$S4" "$T4"
printf "  %-28s %8s ms   %s TFLOPS\n" "PyTorch SDPA fp16:"    "$PT" "$PT_T"
printf "  %-28s %8s ms   %s TFLOPS\n" "cuBLAS ceiling:"       "—"   "$CB"
echo ""

[ -n "$S0" ] && [ -n "$S4" ] && \
    awk -v a="$S0" -v b="$S4" \
        'BEGIN{printf "  Stage 4 vs Naive:      %.1fx faster\n", a/b}'
[ -n "$S3" ] && [ -n "$S4" ] && \
    awk -v a="$S3" -v b="$S4" \
        'BEGIN{printf "  Stage 4 vs Stage 3:    %.2fx faster\n", a/b}'
[ -n "$S4" ] && [ -n "$PT" ] && \
    awk -v s="$S4" -v p="$PT" \
        'BEGIN{printf "  Stage 4 vs PyTorch:    %.1fx slower  (%.1f%% of FA-2)\n", s/p, p/s*100}'
[ -n "$T4" ] && [ -n "$CB" ] && \
    awk -v t="$T4" -v c="$CB" \
        'BEGIN{printf "  Stage 4 TC efficiency: %.1f%% of cuBLAS ceiling\n", t/c*100}'
echo ""

echo "=== Nsight Key Metrics — Stage 4 ==="
grep -E "throughput|stalled_long|stalled_short|warps_active" \
    profile_v4.log 2>/dev/null | sed 's/^[[:space:]]*/  /' \
    || echo "  (see profile_v4.log)"
echo ""

echo "=== Nsight Key Metrics — Stage 3 ==="
grep -E "throughput|stalled_long|stalled_short|warps_active" \
    profile_v3.log 2>/dev/null | sed 's/^[[:space:]]*/  /' \
    || echo "  (see profile_v3.log)"
echo ""

echo "============================================================"
} | tee summary.log

echo ""
echo "Job finished: $(date)"
