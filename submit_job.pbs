#!/bin/bash
#PBS -N sc4064_flashattn
#PBS -l select=1:ngpus=1
#PBS -l walltime=00:45:00
#PBS -q normal
#PBS -j oe
#PBS -o flash_run.log
#PBS -P 52001004

# ============================================================
#  SC4064 FlashAttention — Full Benchmark Job
#
#  Produces:
#    flash_run.log      — this file
#    bench_cuda.log     — Stages 0-4
#    bench_cublas.log   — cuBLAS TC ceiling
#    bench_pytorch.log  — PyTorch FlashAttention-2
#    profile_v3.nsys-rep — Nsight Systems report: Stage 3
#    profile_v4.nsys-rep — Nsight Systems report: Stage 4
#    summary.log        — comparison table
# ============================================================

set -e
cd "$PBS_O_WORKDIR"

echo "============================================================"
echo "  Job:         $PBS_JOBID"
echo "  Node:        $(hostname)"
echo "  Started:     $(date)"
echo "  Working dir: $PBS_O_WORKDIR"
echo "============================================================"
echo ""

# ── Modules ───────────────────────────────────────────────────────────────────
module purge
module load cuda/12.2.2

echo "--- Environment ---"
nvcc --version | head -1
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader
echo ""

# ── Conda ─────────────────────────────────────────────────────────────────────
CONDA_DIR="$HOME/miniconda3"
source "$CONDA_DIR/etc/profile.d/conda.sh"
conda activate sc4064
echo "Python:  $(python3 --version)"
echo "PyTorch: $(python3 -c 'import torch; print(torch.__version__)' 2>/dev/null || echo 'not found')"
echo ""

# ── Build ─────────────────────────────────────────────────────────────────────
echo "--- Build ---"
make clean
make all
echo "Build OK"
echo ""

# ── CUDA benchmark ────────────────────────────────────────────────────────────
echo "--- CUDA benchmark: Stages 0-4 ---"
./flash_attn 2>&1 | tee bench_cuda.log
echo ""

# ── cuBLAS ceiling ────────────────────────────────────────────────────────────
echo "--- cuBLAS Tensor Core ceiling ---"
./cublas_ref 2>&1 | tee bench_cublas.log
echo ""

# ── PyTorch reference ─────────────────────────────────────────────────────────
echo "--- PyTorch SDPA reference ---"
python3 reference.py 2>&1 | tee bench_pytorch.log
echo ""

# ── Nsight Systems profiling (no perf counter permissions needed) ─────────────
# nsys profiles timeline/GPU utilization without hardware counters.
# We profile Stage 3 and Stage 4 separately for clean traces.
# --capture-range=cudaProfilerApi would be ideal but requires code changes;
# instead we just profile the whole run and filter in the report.

echo "--- Nsight Systems: profiling Stage 3 + Stage 4 ---"
if command -v nsys &>/dev/null; then
    nsys profile \
        --output profile_stages \
        --force-overwrite true \
        --trace cuda,nvtx \
        --stats true \
        ./flash_attn > profile_stages_stdout.log 2>&1
    echo "nsys profile complete — see profile_stages.nsys-rep"
    echo "GPU kernel summary:"
    # Print the CUDA kernel summary from nsys stats output
    grep -A 40 "CUDA Kernel Statistics" profile_stages_stdout.log \
        | head -45 || echo "  (see profile_stages_stdout.log for full stats)"
else
    echo "nsys not in PATH — skipping"
fi | tee profile_nsys.log
echo ""

# ── Summary ───────────────────────────────────────────────────────────────────
echo "--- Generating summary ---"
{
echo "============================================================"
echo "  SC4064 FlashAttention — Results Summary"
echo "  $(date)"
echo "  GPU: $(nvidia-smi --query-gpu=name --format=csv,noheader | head -1)"
echo "============================================================"
echo ""

echo "=== CUDA Kernel Stages (N=4096) ==="
awk '/N = 4096/{p=1} p && /Stage/{print "  "$0} p && /^$/{p=0}' bench_cuda.log
echo ""

echo "=== cuBLAS Tensor Core Ceiling ==="
awk '/N = 4096/{p=1} p && /ceiling/{print "  "$0; exit}' bench_cublas.log
echo ""

echo "=== PyTorch FlashAttention-2 Reference (fp16) ==="
awk '/dtype = fp16/{p=1} p && /N= *4096/{print "  "$0; exit}' bench_pytorch.log
echo ""

echo "=== Speedup Table (N=4096) ==="
# Robust extraction: search for N=4096 block then grab the 4th field (ms value)
S0=$(awk '/N = 4096/{p=1} p && /Stage 0/{match($0,/[0-9]+\.[0-9]+ ms/); print substr($0,RSTART,RLENGTH-3); exit}' bench_cuda.log)
S3=$(awk '/N = 4096/{p=1} p && /Stage 3/{match($0,/[0-9]+\.[0-9]+ ms/); print substr($0,RSTART,RLENGTH-3); exit}' bench_cuda.log)
S4=$(awk '/N = 4096/{p=1} p && /Stage 4/{match($0,/[0-9]+\.[0-9]+ ms/); print substr($0,RSTART,RLENGTH-3); exit}' bench_cuda.log)
T3=$(awk '/N = 4096/{p=1} p && /Stage 3/{match($0,/[0-9]+\.[0-9]+ TFLOPS/); print substr($0,RSTART,RLENGTH-7); exit}' bench_cuda.log)
T4=$(awk '/N = 4096/{p=1} p && /Stage 4/{match($0,/[0-9]+\.[0-9]+ TFLOPS/); print substr($0,RSTART,RLENGTH-7); exit}' bench_cuda.log)
PT=$(awk '/dtype = fp16/{p=1} p && /N= *4096/{match($0,/[0-9]+\.[0-9]+ ms/); print substr($0,RSTART,RLENGTH-3); exit}' bench_pytorch.log)
PT_T=$(awk '/dtype = fp16/{p=1} p && /N= *4096/{match($0,/[0-9]+\.[0-9]+ TFLOPS/); print substr($0,RSTART,RLENGTH-7); exit}' bench_pytorch.log)
CB=$(awk '/N = 4096/{p=1} p && /ceiling/{match($0,/[0-9]+\.[0-9]+ TFLOPS/); print substr($0,RSTART,RLENGTH-7); exit}' bench_cublas.log)

printf "  %-28s %8s ms   %s TFLOPS\n" "Stage 0 (Naive):"      "${S0:----}"  "—"
printf "  %-28s %8s ms   %s TFLOPS\n" "Stage 3 (wmma 32x32):" "${S3:----}"  "${T3:----}"
printf "  %-28s %8s ms   %s TFLOPS\n" "Stage 4 (wmma 64x64):" "${S4:----}"  "${T4:----}"
printf "  %-28s %8s ms   %s TFLOPS\n" "PyTorch SDPA fp16:"    "${PT:----}"  "${PT_T:----}"
printf "  %-28s %8s ms   %s TFLOPS\n" "cuBLAS ceiling:"       "—"           "${CB:----}"
echo ""

[ -n "$S0" ] && [ -n "$S4" ] && [ "$S4" != "0" ] && \
    awk -v a="$S0" -v b="$S4" \
        'BEGIN{printf "  Stage 4 vs Naive:      %.1fx faster\n", a/b}'
[ -n "$S3" ] && [ -n "$S4" ] && [ "$S4" != "0" ] && \
    awk -v a="$S3" -v b="$S4" \
        'BEGIN{printf "  Stage 4 vs Stage 3:    %.2fx faster\n", a/b}'
[ -n "$S4" ] && [ -n "$PT" ] && [ "$PT" != "0" ] && \
    awk -v s="$S4" -v p="$PT" \
        'BEGIN{printf "  Stage 4 vs PyTorch:    %.1fx slower  (%.1f%% of FA-2)\n", s/p, p/s*100}'
[ -n "$T4" ] && [ -n "$CB" ] && [ "$CB" != "0" ] && \
    awk -v t="$T4" -v c="$CB" \
        'BEGIN{printf "  Stage 4 TC efficiency: %.1f%% of cuBLAS ceiling\n", t/c*100}'
echo ""

echo "=== Nsight Systems — GPU Kernel Summary ==="
grep -A 40 "CUDA Kernel Statistics\|Time(%)" profile_nsys.log 2>/dev/null \
    | head -30 | sed 's/^/  /' || echo "  (see profile_nsys.log)"
echo ""

echo "============================================================"
} | tee summary.log

echo ""
echo "Job finished: $(date)"
