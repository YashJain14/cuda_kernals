#!/bin/bash
#PBS -N stage9_flashattn
#PBS -l select=1:ngpus=1
#PBS -l walltime=00:15:00
#PBS -q normal
#PBS -j oe
#PBS -o stage9_output.log
#PBS -P 52001004

# ============================================================
#  SC4064 FlashAttention — Stage 9 Benchmark Job
# ============================================================

set -e
cd "$PBS_O_WORKDIR"

# ── Modules ───────────────────────────────────────────────────────────────────
module purge
module load cuda/12.2.2

# ── Environment ──
echo "--- Environment ---"
nvcc --version | head -1
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader
echo ""

# ── Build ─────────────────────────────────────────────────────────────────────
# Using the same CUTLASS path logic as the main Makefile
CUTLASS_PATH="$HOME/cuda_kernals/cutlass"

echo "--- Building Stage 9 ---"
nvcc -O3 -arch=sm_80 --use_fast_math -std=c++17 \
     -I"$CUTLASS_PATH/include" \
     stage9.cu -o stage9_test -lcublas

echo "Build OK"
echo ""

# ── Run Benchmark ─────────────────────────────────────────────────────────────
echo "--- Running Stage 9 Benchmark ---"
./stage9_test

echo ""
echo "Job finished: $(date)"
